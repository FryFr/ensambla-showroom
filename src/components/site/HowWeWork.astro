---
const steps = [
  {
    n: '01',
    title: 'Eliges y charlamos',
    body: 'Pruebas una demo, pulsas "Quiero una así" y nos cuentas tu caso. Sin vueltas ni formularios eternos.',
  },
  {
    n: '02',
    title: 'Ensamblamos tu solución',
    body: 'Armamos exactamente lo que necesitas —web, tienda, bot o automatización— con la calidad que viste en las demos.',
  },
  {
    n: '03',
    title: 'Queda funcionando solo',
    body: 'Lo dejamos andando, medible y fácil de mantener. Tú te dedicas a tu negocio; el software trabaja por ti.',
  },
];
---

<section id="como-trabajamos" class="mx-auto max-w-6xl scroll-mt-20 px-5 py-16">
  <p class="techlabel">Cómo trabajamos</p>
  <h2 class="mt-1 font-display text-3xl font-bold sm:text-4xl">
    De la demo a tu negocio, en 3 pasos.
  </h2>

  <ol class="mt-10 grid gap-4 md:grid-cols-3">
    {
      steps.map((s) => (
        <li class="card relative p-6">
          <span class="font-mono text-4xl font-medium text-accent/40">
            {s.n}
          </span>
          <h3 class="mt-3 font-display text-xl font-semibold">{s.title}</h3>
          <p class="mt-2 text-sm text-ink-muted">{s.body}</p>
        </li>
      ))
    }
  </ol>
</section>
