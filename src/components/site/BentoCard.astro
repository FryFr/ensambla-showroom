---
import type { Demo } from '../../data/demos';

interface Props {
  demo: Demo;
}
const { demo } = Astro.props;

const spanClass: Record<Demo['span'], string> = {
  sm: 'sm:col-span-1 sm:row-span-1',
  md: 'sm:col-span-2 sm:row-span-1',
  lg: 'sm:col-span-2 sm:row-span-2',
};

const grupoAccent: Record<Demo['grupo'], string> = {
  contacto: 'var(--color-accent)',
  venta: 'var(--color-accent-lime)',
  atencion: 'var(--color-signal)',
  operacion: '#8b7cf6',
};
const accent = grupoAccent[demo.grupo];
---

<a
  href={`/demos/${demo.slug}`}
  class={`card group relative flex min-h-[13rem] flex-col justify-between overflow-hidden p-5 transition-transform hover:-translate-y-1 ${spanClass[demo.span]}`}
  style={`--accent: ${accent}`}
  aria-label={`Abrir demo: ${demo.title}`}
>
  <!-- glow de acento en hover (radial-gradient: sin filter:blur, estable) -->
  <div
    class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100"
    style="background: radial-gradient(220px circle at top right, color-mix(in srgb, var(--accent) 22%, transparent), transparent 72%)"
  >
  </div>

  <div class="relative flex items-start justify-between">
    <span class="text-3xl">{demo.icon}</span>
    {
      demo.featured && (
        <span
          class="techlabel rounded-full border px-2.5 py-1 text-[0.62rem]"
          style="border-color: color-mix(in srgb, var(--accent) 40%, transparent); color: var(--accent)"
        >
          ★ Demo estrella
        </span>
      )
    }
    {
      demo.hasBackend && !demo.featured && (
        <span class="techlabel flex items-center gap-1.5 text-[0.62rem]">
          <span class="dot-live inline-block h-1.5 w-1.5 rounded-full" style="background: var(--accent)" />
          IA real
        </span>
      )
    }
  </div>

  <div class="relative">
    <p class="techlabel" style="color: var(--accent)">{demo.kicker}</p>
    <h3 class="mt-1.5 line-clamp-2 font-display text-xl font-semibold leading-tight sm:text-2xl">
      {demo.title}
    </h3>
    <p class="mt-1 line-clamp-2 text-sm text-ink-muted sm:line-clamp-1 lg:line-clamp-2">{demo.tagline}</p>
    <!-- tiempo (reposo) ↔ CTA (hover) en el MISMO renglón: no agrega alto -->
    <div class="relative mt-1.5 h-4">
      <p
        class="absolute inset-0 truncate text-xs font-medium leading-4 transition-opacity group-hover:opacity-0"
        style="color: var(--accent)"
      >
        ⚡ Lista en {demo.tiempo}
      </p>
      <span
        class="absolute inset-0 inline-flex items-center gap-1 text-xs font-medium leading-4 opacity-0 transition-opacity group-hover:opacity-100"
        style="color: var(--accent)"
      >
        Probar demo →
      </span>
    </div>
  </div>
</a>
