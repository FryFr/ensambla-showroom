---
// Tarjeta de un trabajo REAL (cliente publicado), para el menú de la Home.
// Sin iframe ni JS: la captura es un enlace a la ficha /trabajos/<slug>.
// La previsualización en vivo vive en la ficha, no acá (Home sin JavaScript).
import { ESTADOS, type Trabajo } from '../../data/trabajos';

interface Props {
  trabajo: Trabajo;
}
const { trabajo } = Astro.props;
const estado = ESTADOS[trabajo.estado];
---

<a
  href={`/trabajos/${trabajo.slug}`}
  class="card group relative flex flex-col overflow-hidden transition-transform hover:-translate-y-1"
  style={`--accent: ${trabajo.accent}`}
  aria-label={`Ver el trabajo de ${trabajo.title}`}
>
  <!-- Captura real del sitio, en escritorio -->
  <div class="relative aspect-[16/10] overflow-hidden border-b border-white/5 bg-surface">
    <img
      src={trabajo.shots.desktop}
      alt={trabajo.shots.altDesktop}
      width="1600"
      height="1000"
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover object-top"
    />
    <!-- velo de acento en hover (no tapa el contenido en reposo) -->
    <div
      class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100"
      style="background: radial-gradient(320px circle at 80% 0%, color-mix(in srgb, var(--accent) 24%, transparent), transparent 70%)"
    >
    </div>
  </div>

  <div class="flex flex-1 flex-col p-5 sm:p-6">
    <div class="flex items-start justify-between gap-3">
      <p class="techlabel" style="color: var(--accent)">{trabajo.kicker}</p>
      <span
        class="techlabel shrink-0 rounded-full border px-2.5 py-1 text-[0.62rem]"
        style="border-color: color-mix(in srgb, var(--accent) 35%, transparent); color: var(--accent)"
      >
        {estado.label}
      </span>
    </div>

    <h3 class="mt-1.5 font-display text-2xl font-semibold leading-tight sm:text-3xl">
      {trabajo.title}
    </h3>
    <p class="mt-1.5 text-sm text-ink-muted">{trabajo.tagline}</p>

    <div class="mt-4 flex flex-wrap items-center justify-between gap-2 pt-1">
      <span class="techlabel truncate">{trabajo.host}</span>
      <span class="text-sm font-medium" style="color: var(--accent)">Ver el trabajo →</span>
    </div>
  </div>
</a>
