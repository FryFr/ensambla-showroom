---
import '../styles/global.css';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /** Ocultar header/footer (para vistas de demo a pantalla completa) */
  chrome?: boolean;
  /** Imagen para redes, ruta absoluta del sitio (ej. /trabajos/milu-og.jpg) */
  image?: string;
}

const {
  title = 'Ensambla — Software y automatizaciones que hacen que tu negocio funcione solo',
  description = 'Showroom de Ensambla: un menú de mini-demos interactivas de desarrollo web y automatización con IA. Pruébalas y pide la tuya.',
  chrome = true,
  image,
} = Astro.props;

// og:image y canonical tienen que ser URLs absolutas para que las redes las
// resuelvan. `Astro.site` sale de `site` en astro.config (PUBLIC_SITE_URL).
// Si no está definida no inventamos un dominio: se omiten las etiquetas.
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site && image ? new URL(image, Astro.site).href : undefined;
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content="Ensambla" />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="theme-color" content="#0B0F14" />
    <script is:inline>
      // El navegador NO restaura el scroll al recargar: toda entrada fresca a "/"
      // arranca arriba (el hero). Un enlace con #ancla sigue funcionando normal.
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
    </script>
  </head>
  <body class="blueprint-bg min-h-screen">
    <a href="#main" class="skip-link">Saltar al contenido</a>
    {chrome && <Header />}
    <main id="main">
      <slot />
    </main>
    {chrome && <Footer />}
  </body>
</html>
