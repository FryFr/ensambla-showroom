---
import BaseLayout from '../layouts/BaseLayout.astro';
import { demosBySlug } from '../data/demos';

// Render por request para poder leer ?tipo= (en modo estático la query no existe).
export const prerender = false;

const tipo = Astro.url.searchParams.get('tipo');
const demo = tipo ? demosBySlug[tipo] : undefined;

const waNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER ?? '5491100000000';
const waText = demo
  ? `Hola Ensambla 👋 Me interesó la demo de "${demo.title}". Quiero una así para mi negocio.`
  : 'Hola Ensambla 👋 Vi el showroom y quiero hablar de un proyecto.';
const waLink = `https://wa.me/${waNumber}?text=${encodeURIComponent(waText)}`;
---

<BaseLayout title="Contacto — Ensambla" description="Escríbenos por WhatsApp y hablamos de tu proyecto.">
  <section class="mx-auto flex max-w-2xl flex-col items-center px-5 py-20 text-center">
    <p class="techlabel">Contacto</p>
    <h1 class="mt-2 font-display text-4xl font-bold sm:text-5xl">
      Hablemos por WhatsApp.
    </h1>
    <p class="mt-4 max-w-lg text-lg text-ink-muted">
      Es la vía más rápida y directa. Cuéntanos tu caso y te respondemos personalmente, sin vueltas ni formularios eternos.
    </p>

    {
      demo && (
        <div class="mt-6 inline-flex items-center gap-2 rounded-full border border-accent/25 bg-accent/5 px-4 py-2 text-sm">
          <span class="dot-live inline-block h-2 w-2 rounded-full bg-accent" />
          <span class="text-ink-muted">
            Te interesó: <strong class="text-ink">{demo.title}</strong>
          </span>
        </div>
      )
    }

    <!-- CTA principal de WhatsApp -->
    <a
      href={waLink}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-9 inline-flex items-center gap-3 rounded-full bg-[#25D366] px-8 py-4 text-lg font-semibold text-[#07120b] shadow-lg shadow-[#25D366]/20 transition-transform hover:-translate-y-0.5"
    >
      <span class="text-2xl">💬</span>
      Escribir por WhatsApp
      <span aria-hidden="true">→</span>
    </a>

    <!-- Por qué Ensambla -->
    <div class="card mt-14 w-full max-w-md p-6 text-left">
      <p class="techlabel">Por qué Ensambla</p>
      <ul class="mt-3 space-y-2.5 text-sm text-ink-muted">
        <li class="flex gap-2.5"><span class="text-accent">✓</span> Todo lo que viste en las demos, hecho para ti</li>
        <li class="flex gap-2.5"><span class="text-accent">✓</span> Rápido, medible y fácil de mantener</li>
        <li class="flex gap-2.5"><span class="text-accent">✓</span> Web + automatización con IA en un solo lugar</li>
      </ul>
    </div>

    <a href="/#demos" class="mt-10 text-sm text-ink-muted transition-colors hover:text-ink">
      ← Volver a las demos
    </a>
  </section>
</BaseLayout>
