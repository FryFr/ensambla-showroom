# ─────────────────────────────────────────────────────────────
# Ensambla Showroom — variables de entorno
# Copia este archivo a `.env` (cp env.example .env) y completa los valores.
# ─────────────────────────────────────────────────────────────

# Chatbot con IA (única demo con backend).
# Proveedor por defecto: Groq (gratis y rápido). Saca tu key en https://console.groq.com/keys
GROQ_API_KEY=

# Opcional: modelo de Groq a usar. Default: openai/gpt-oss-120b
# OJO: Groq deprecó los llama-3.x el 16/08/2026. Verifica en console.groq.com/docs/deprecations
# antes de cambiar; usa modelos estables (no *preview*).
# GROQ_MODEL=openai/gpt-oss-120b

# Número de WhatsApp para el CTA de /contacto (formato internacional, solo dígitos).
# Ejemplo Colombia: 573001112233
PUBLIC_WHATSAPP_NUMBER=573000000000
