# ─────────────────────────────────────────────────────────────
# Ensambla Showroom — variables de entorno
# Copiá este archivo a `.env` (cp env.example .env) y completá los valores.
# ─────────────────────────────────────────────────────────────

# Chatbot con IA (única demo con backend).
# Proveedor por defecto: Groq (gratis y rápido). Sacá tu key en https://console.groq.com/keys
GROQ_API_KEY=

# Opcional: modelo de Groq a usar. Default: llama-3.3-70b-versatile
# GROQ_MODEL=llama-3.3-70b-versatile

# Número de WhatsApp para el CTA de /contacto (formato internacional, solo dígitos).
# Ejemplo Argentina: 5491122334455
PUBLIC_WHATSAPP_NUMBER=5491100000000
